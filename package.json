{
  "name": "flagfield",
  "version": "1.0.1",
  "author": "Sergey Kosilov",
  "homepage": "https://github.com/sergejkosilov/countries",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4205",
    "build": "ng build",
    "build:release": "ng build --configuration=production-local",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --no-watch --browsers=ChromeHeadless",
    "lint": "ng lint",
    "cap:sync": "ng build && npx cap sync",
    "cap:sync:release": "ng build --configuration=production-local && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "build:ios:archive": "bash scripts/build-ios-appstore.sh",
    "assets:generate": "npx --yes @capacitor/assets generate --assetPath resources --iconBackgroundColor '#f0f9ff' --iconBackgroundColorDark '#1e3a8a' --splashBackgroundColor '#f0f9ff' --splashBackgroundColorDark '#0f172a'",
    "legal:build": "node scripts/build-legal-site.mjs",
    "env:init": "cp src/environments/environment.prod.local.example.ts src/environments/environment.prod.local.ts",
    "data:knowledge": "node scripts/enrich-country-knowledge.mjs",
    "i18n:flagfield:translate": "node scripts/translate-flagfield-lingva.mjs",
    "i18n:flagfield:translate:mymemory": "node scripts/translate-flagfield-mymemory.mjs",
    "i18n:flagfield:translate:google": "node scripts/translate-flagfield-google.mjs",
    "i18n:flagfield:uk": "node scripts/ru-to-uk-flagfield.mjs",
    "i18n:flagfield:build": "node scripts/build-flagfield-locales.mjs",
    "i18n:flagfield:complete": "bash scripts/i18n-flagfield-complete.sh",
    "i18n:flagfield:continue": "bash scripts/i18n-flagfield-continue.sh"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@capacitor/android": "^8.2.0",
    "@capacitor/app": "8.0.1",
    "@capacitor/browser": "^8.0.2",
    "@capacitor/camera": "^8.0.2",
    "@capacitor/core": "8.2.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "8.0.1",
    "@capacitor/ios": "^8.2.0",
    "@capacitor/keyboard": "8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "8.0.1",
    "@ionic/angular": "^8.0.0",
    "@revenuecat/purchases-capacitor": "^12.3.0",
    "@types/three": "^0.184.1",
    "ionicons": "^7.0.0",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "three": "^0.184.0",
    "three-globe": "^2.45.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular-eslint/builder": "^20.0.0",
    "@angular-eslint/eslint-plugin": "^20.0.0",
    "@angular-eslint/eslint-plugin-template": "^20.0.0",
    "@angular-eslint/schematics": "^20.0.0",
    "@angular-eslint/template-parser": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@angular/language-service": "^20.0.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.2.0",
    "@ionic/angular-toolkit": "^12.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "^1.9.21",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitalets/google-translate-api": "^9.2.1",
    "eslint": "^9.16.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.2.1",
    "eslint-plugin-prefer-arrow": "1.2.2",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.0"
  },
  "description": "An Ionic project"
}
